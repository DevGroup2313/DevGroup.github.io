     NO LICENCE IS GRANTED. See LICENCE.txt.
     Lakay for the Fire tablet: one activity holding the web view that runs
     Lakay.html from inside the package (assets/), at
     https://appassets.androidplatform.net/assets/. The version is written by
     the build (.github/workflows/fire.yml) from build.json.
     INTERNET is declared only because Android's web view asks for it to load
     any https address, even one served from inside the package; the page's own
     security policy (connect-src 'none') forbids every connection.
     The configuration changes are handled by the activity itself, so turning
     the tablet or changing its look never reloads the page (which would lock
     the store). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yannieforest.emporium">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Lakay"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="app.emporium.shell.ShellActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
